CARD_PIPELINE_DEVICE=auto
CARD_PIPELINE_MODEL_CACHE_DIR=models/embedding
CARD_PIPELINE_ALLOW_MODEL_DOWNLOADS=false
CARD_PIPELINE_PREPROCESSING_MODE=none
# CARD_PIPELINE_YOLO_MODEL_PATH=models/detection/card-segmentation.pt

# Enable only the capabilities whose optional dependencies and models are installed.
CARD_PIPELINE_RETRIEVAL_ENABLED=true
CARD_PIPELINE_OCR_ENABLED=false
CARD_PIPELINE_RAG_ENABLED=false

CARD_PIPELINE_MILVUS_URI=http://127.0.0.1:19530
CARD_PIPELINE_MILVUS_TOKEN=
CARD_PIPELINE_MILVUS_COLLECTION=trading_card_embeddings_v1
CARD_PIPELINE_CREATE_COLLECTION_ON_STARTUP=false
CARD_PIPELINE_RANKER_ENABLED=false
CARD_PIPELINE_RANKER_MODEL_PATH=models/ranking/ranking_model.joblib

CARD_PIPELINE_OLLAMA_URL=http://127.0.0.1:11434
CARD_PIPELINE_OCR_MODEL_NAME=qwen3-vl:8b-instruct-q8_0
CARD_PIPELINE_OCR_MODEL_TIMEOUT=180
CARD_PIPELINE_OCR_CONCURRENCY=2
CARD_PIPELINE_DEPENDENCY_CHECK_TIMEOUT=3

CARD_PIPELINE_CHROMA_PERSIST_DIR=data/chroma_db
CARD_PIPELINE_CHROMA_COLLECTION=cards
CARD_PIPELINE_RAG_EMBEDDING_MODEL=models/rag/BAAI/bge-m3
CARD_PIPELINE_RAG_DEVICE=auto
CARD_PIPELINE_RAG_CANDIDATE_LIMIT=5

# Comma-separated browser origins. Leave empty for server-to-server use.
CARD_PIPELINE_CORS_ORIGINS=
